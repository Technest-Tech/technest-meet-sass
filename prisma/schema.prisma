// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Seed configuration
// Run with: npm run db:seed

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Account types enum
enum AccountRole {
  SUPER_ADMIN
  CLIENT
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  TRIAL
  TRIAL_EXPIRED
}

enum FeatureType {
  RECORDING
  WAITING_ROOM
  PRIVATE_CHAT
  GUEST_UNMUTE
  HOST_APPROVAL
  SCREEN_ANNOTATION
  FILE_SHARING
  PDF_VIEWER
  REACTIONS
  RAISE_HAND
  E2EE
  CUSTOM_BRANDING
  PICTURE_IN_PICTURE
  STUDENT_MONITOR_PIP
  COLLABORATIVE_WHITEBOARD
  NORMAL_WHITEBOARD
  MANAGE_PARTICIPANTS
  VIRTUAL_BACKGROUND
  NOISE_CANCELLATION
}

enum PasswordFor {
  HOST_ONLY
  HOST_AND_GUEST
}

enum ReferralEventType {
  REGISTERED
  SUBSCRIBED
  LARGE_PLAN
}

enum ReferralEventStatus {
  PENDING
  QUALIFIED
  CANCELED
}

enum RewardType {
  FREE_ROOMS
  DISCOUNT
  MONTH_EXTENSION
  CREDIT
}

enum RedeemRequestStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
}

enum ProspectStatus {
  NEW
  CONTACTED
  ACTIVATED
  ARCHIVED
}

enum ActivityEventType {
  ROOM_CREATED
  ROOM_UPDATED
  ROOM_STARTED
  ROOM_ENDED
  PARTICIPANT_JOINED
  PARTICIPANT_LEFT
  FILE_UPLOADED
  FILE_DELETED
  SYSTEM_ALERT
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
  PAST_DUE
  REFUNDED
}

// Super Admin - Single super admin account
model SuperAdmin {
  id                   String                 @id @default(cuid())
  email                String                 @unique
  password             String // Hashed with bcrypt
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  ProspectRegistration ProspectRegistration[]
  RewardCatalog        RewardCatalog[]
  RedeemRequest        RedeemRequest[]
  accountNotes         AccountNote[]

  @@map("super_admins")
}

// Account - Unified account model for all users
model Account {
  id        String        @id @default(cuid())
  email     String        @unique
  password  String // Hashed with bcrypt
  role      AccountRole
  status    AccountStatus @default(ACTIVE)
  clientId  String? // Only set if role is CLIENT
  client    Client?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  notes     AccountNote[]
  activityLogs RoomActivityLog[]

  @@index([clientId])
  @@index([role, status])
  @@map("accounts")
}

// Client - Tenant organization
model Client {
  id        String  @id @default(cuid())
  name      String
  email     String  @unique
  whatsappNumber String?
  accountId String  @unique // Link to Account
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // Limits (set by super admin)
  maxRooms            Int     @default(10)
  maxParticipants     Int     @default(50) // Maximum participants per room
  enableObserverLinks Boolean @default(true)

  // Subscription
  subscription Subscription?

  // Relations
  rooms          Room[]
  hostAccounts   HostAccount[]
  guestAccounts  GuestAccount[]
  referralLink   ReferralLink?
  redeemRequests RedeemRequest[]
  activityLogs   RoomActivityLog[]
  invoices       BillingInvoice[]
  storageSnapshots StorageSnapshot[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  ReferralEvent ReferralEvent[]

  @@map("clients")
}

// Plan - Subscription plan template
model Plan {
  id          String  @id @default(cuid())
  name        String
  description String?
  isActive    Boolean @default(true)

  // Relations
  features      PlanFeature[]
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plans")
}

// PlanFeature - Junction table for plan features
model PlanFeature {
  id        String      @id @default(cuid())
  planId    String
  plan      Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature   FeatureType
  enabled   Boolean     @default(true)
  createdAt DateTime    @default(now())

  @@unique([planId, feature])
  @@index([planId])
  @@map("plan_features")
}

// Subscription - Client's active subscription
model Subscription {
  id       String             @id @default(cuid())
  clientId String             @unique
  client   Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  planId   String
  plan     Plan               @relation(fields: [planId], references: [id])
  status   SubscriptionStatus @default(INACTIVE)
  invoices BillingInvoice[]
  sourceId String?
  source   SubscriptionSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  startDate DateTime? @default(now())
  endDate   DateTime?
  amountEGP Int?      @default(0)

  // Trial fields
  isTrial        Boolean   @default(false)
  trialStartDate DateTime?
  trialEndDate   DateTime?
  trialDays      Int?      @default(3) // Default 3 days

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([clientId])
  @@index([sourceId])
  @@index([isTrial, trialEndDate]) // For querying active trials
  @@map("subscriptions")
}

model SubscriptionSource {
  id          String          @id @default(cuid())
  label       String
  description String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  subscriptions Subscription[]

  @@index([isActive])
  @@map("subscription_sources")
}

// Room - Meeting rooms (belongs to client)
model Room {
  id          String  @id @default(cuid())
  name        String
  description String?
  clientId    String
  client      Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Room settings (inherited from plan features, but can be overridden per room)
  hostApproval                  Boolean @default(false)
  allowMultipleHosts            Boolean @default(false) // Allow multiple hosts in the same room
  maxParticipants               Int     @default(50)
  isActive                      Boolean @default(true)
  canRecord                     Boolean @default(false)
  requireWaitingRoom            Boolean @default(false)
  allowGuestUnmute              Boolean @default(true)
  enablePrivateChat             Boolean @default(true)
  enableScreenAnnotation        Boolean @default(false)
  enableFileSharing             Boolean @default(false)
  enablePdfViewer               Boolean @default(false)
  enableReactions               Boolean @default(false)
  enableRaiseHand               Boolean @default(false)
  enableE2EE                    Boolean @default(false)
  enableCollaborativeWhiteboard Boolean @default(false)
  enableNormalWhiteboard        Boolean @default(false)
  enableManageParticipants      Boolean @default(false)
  enableVirtualBackground       Boolean @default(false)
  enableNoiseCancellation       Boolean @default(false)

  // Links
  hostLink     String  @unique
  guestLink    String  @unique
  observerLink String? @unique // Secret link for silent observers

  // Active host tracking
  activeHostIdentity  String? // Track active host identity
  activeHostSessionId String? // Track active host session ID
  activeHostLastSeen  DateTime? // Last time active host was seen

  // Password protection
  password         String? // Hashed password
  passwordRequired Boolean      @default(false)
  passwordFor      PasswordFor?

  // Relations
  participants        Participant[]
  files               RoomFile[]
  waitingParticipants WaitingParticipant[]
  hostAccounts        HostAccount[]
  guestAccounts       GuestAccount[]
  activityLogs        RoomActivityLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([isActive])
  @@map("rooms")
}

// Participant - Room participants
model Participant {
  id        String   @id @default(cuid())
  name      String
  type      String // HOST or GUEST
  roomId    String
  used      Boolean  @default(false)
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomId, name])
  @@index([roomId])
  @@map("participants")
}

// RoomFile - Files uploaded to rooms
model RoomFile {
  id           String   @id @default(cuid())
  roomId       String
  filename     String
  originalName String
  fileType     String
  size         Int
  uploadedBy   String
  uploadedAt   DateTime @default(now())
  room         Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@map("room_files")
}

// WaitingParticipant - Waiting room participants
model WaitingParticipant {
  id              String   @id @default(cuid())
  roomId          String
  participantName String
  participantType String
  status          String   @default("waiting")
  joinedAt        DateTime @default(now())
  room            Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, status])
  @@map("waiting_participants")
}

// HostAccount - Predefined host accounts for rooms
model HostAccount {
  id        String   @id @default(cuid())
  name      String
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  roomId    String?
  room      Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([roomId])
  @@map("host_accounts")
}

// GuestAccount - Predefined guest accounts for rooms
model GuestAccount {
  id        String   @id @default(cuid())
  name      String
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  roomId    String?
  room      Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([roomId])
  @@map("guest_accounts")
}

model AccountNote {
  id        String      @id @default(cuid())
  accountId String
  account   Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  authorId  String?
  author    SuperAdmin? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  content   String
  tags      String[]    @default([])
  isPinned  Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([accountId, isPinned])
  @@map("account_notes")
}

model RoomActivityLog {
  id             String            @id @default(cuid())
  clientId       String
  client         Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  roomId         String
  room           Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  event          ActivityEventType
  description    String?
  metadata       Json?
  occurredAt     DateTime          @default(now())
  actorAccountId String?
  actorAccount   Account?          @relation(fields: [actorAccountId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())

  @@index([clientId, occurredAt])
  @@index([roomId, occurredAt])
  @@map("room_activity_logs")
}

model BillingInvoice {
  id              String        @id @default(cuid())
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  subscriptionId  String?
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  status          InvoiceStatus @default(OPEN)
  amountCents     Int
  currency        String        @default("EGP")
  issuedAt        DateTime      @default(now())
  dueAt           DateTime?
  paidAt          DateTime?
  periodStart     DateTime?
  periodEnd       DateTime?
  description     String?
  metadata        Json?
  pdfUrl          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([clientId, status])
  @@index([subscriptionId])
  @@map("billing_invoices")
}

model StorageSnapshot {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  totalBytes    BigInt   @default(0)
  totalFiles    Int      @default(0)
  totalRooms    Int      @default(0)
  activeRooms   Int      @default(0)
  capturedAt    DateTime @default(now())
  breakdown     Json?
  createdAt     DateTime @default(now())

  @@index([clientId, capturedAt])
  @@map("storage_snapshots")
}

model ReferralSetting {
  id                 String   @id @default(cuid())
  registerPoints     Int      @default(5)
  subscribePoints    Int      @default(25)
  largePlanPoints    Int      @default(40)
  largePlanThreshold Int?
  minRedeemPoints    Int      @default(50)
  creditPointValue   Int      @default(1)
  freeRoomDays       Int      @default(30)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("referral_settings")
}

model ReferralLink {
  id              String          @id @default(cuid())
  clientId        String          @unique
  client          Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  code            String          @unique
  qrCodeUrl       String?
  totalPoints     Int             @default(0)
  availablePoints Int             @default(0)
  redeemedPoints  Int             @default(0)
  referralCount   Int             @default(0)
  referralEvents  ReferralEvent[]
  redeemRequests  RedeemRequest[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("referral_links")
}

model ReferralEvent {
  id               String                @id @default(cuid())
  referralLinkId   String
  referralLink     ReferralLink          @relation(fields: [referralLinkId], references: [id], onDelete: Cascade)
  referredEmail    String?
  referredClientId String?
  referredClient   Client?               @relation(fields: [referredClientId], references: [id], onDelete: SetNull)
  eventType        ReferralEventType
  status           ReferralEventStatus   @default(PENDING)
  pointsAwarded    Int                   @default(0)
  metadata         Json?
  occurredAt       DateTime              @default(now())
  processedAt      DateTime?
  prospect         ProspectRegistration?

  @@index([referralLinkId, eventType, status])
  @@index([referredClientId])
  @@map("referral_events")
}

model ProspectRegistration {
  id              String         @id @default(cuid())
  referralEventId String         @unique
  referralEvent   ReferralEvent  @relation(fields: [referralEventId], references: [id], onDelete: Cascade)
  name            String?
  email           String?
  phone           String?
  companyName     String?
  desiredPlanId   String?
  notes           String?
  status          ProspectStatus @default(NEW)
  assignedAdminId String?
  assignedAdmin   SuperAdmin?    @relation(fields: [assignedAdminId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("prospect_registrations")
}

model RewardCatalog {
  id             String          @id @default(cuid())
  label          String
  description    String?
  rewardType     RewardType
  config         Json?
  costPoints     Int
  isActive       Boolean         @default(true)
  createdById    String?
  createdBy      SuperAdmin?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  redeemRequests RedeemRequest[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([label])
  @@map("reward_catalog")
}

model RedeemRequest {
  id             String              @id @default(cuid())
  clientId       String
  client         Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  referralLinkId String?
  referralLink   ReferralLink?       @relation(fields: [referralLinkId], references: [id], onDelete: SetNull)
  rewardId       String?
  reward         RewardCatalog?      @relation(fields: [rewardId], references: [id], onDelete: SetNull)
  pointsSpent    Int
  status         RedeemRequestStatus @default(PENDING)
  notes          String?
  payload        Json?
  reviewedById   String?
  reviewedBy     SuperAdmin?         @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([clientId, status])
  @@index([rewardId])
  @@index([reviewedById])
  @@map("redeem_requests")
}
